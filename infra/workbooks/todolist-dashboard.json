{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# TodoList Application Monitoring Dashboard\n\nThis dashboard provides insights into the TodoList application performance and health."
      },
      "name": "text - dashboard title"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "47008b17-7bd8-44b5-9bb8-7e8b6d1a5fdb",
            "version": "KqlParameterItem/1.0",
            "name": "TimeRange",
            "type": 4,
            "isRequired": true,
            "value": {
              "durationMs": 3600000
            },
            "typeSettings": {
              "selectableValues": [
                {
                  "durationMs": 300000
                },
                {
                  "durationMs": 900000
                },
                {
                  "durationMs": 1800000
                },
                {
                  "durationMs": 3600000
                },
                {
                  "durationMs": 14400000
                },
                {
                  "durationMs": 43200000
                },
                {
                  "durationMs": 86400000
                }
              ]
            }
          }
        ]
      },
      "name": "parameters - time range"
    },
    {
      "type": 10,
      "content": {
        "chartId": "workbook-item-chart-1",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 2,
        "resourceType": "microsoft.insights/components",
        "metricScope": 0,
        "resourceParameter": "Application",
        "resourceIds": [
          "{Application}"
        ],
        "timeContextFromParameter": "TimeRange",
        "timeContext": {
          "durationMs": 0
        },
        "metrics": [
          {
            "namespace": "microsoft.insights/components",
            "metric": "microsoft.insights/components-Browser-browserTimings/totalDuration",
            "aggregation": 4,
            "splitBy": null
          },
          {
            "namespace": "microsoft.insights/components",
            "metric": "microsoft.insights/components-Kusto-requests/duration",
            "aggregation": 4
          }
        ],
        "title": "Page Response Times",
        "gridSettings": {
          "rowLimit": 10000
        }
      },
      "customWidth": "50",
      "name": "metric - response times"
    },
    {
      "type": 10,
      "content": {
        "chartId": "workbook-item-chart-2",
        "version": "MetricsItem/2.0",
        "size": 0,
        "chartType": 2,
        "resourceType": "microsoft.insights/components",
        "metricScope": 0,
        "resourceParameter": "Application",
        "resourceIds": [
          "{Application}"
        ],
        "timeContextFromParameter": "TimeRange",
        "timeContext": {
          "durationMs": 0
        },
        "metrics": [
          {
            "namespace": "microsoft.insights/components",
            "metric": "microsoft.insights/components-Kusto-requests/count",
            "aggregation": 1,
            "splitBy": null
          }
        ],
        "title": "Request Count",
        "gridSettings": {
          "rowLimit": 10000
        }
      },
      "customWidth": "50",
      "name": "metric - request count"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "requests\n| where timestamp >= ago({TimeRange:timespan})\n| summarize \n    TotalRequests = count(),\n    SuccessfulRequests = countif(success == true),\n    FailedRequests = countif(success == false),\n    AvgDuration = avg(duration)\n| extend SuccessRate = round(SuccessfulRequests * 100.0 / TotalRequests, 2)",
        "size": 3,
        "title": "Request Summary",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "tiles",
        "tileSettings": {
          "showBorder": false,
          "titleContent": {
            "columnMatch": "TotalRequests",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            }
          },
          "leftContent": {
            "columnMatch": "TotalRequests",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            },
            "numberFormat": {
              "unit": 17,
              "options": {
                "maximumSignificantDigits": 3,
                "maximumFractionDigits": 2
              }
            }
          }
        }
      },
      "name": "query - request summary"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "exceptions\n| where timestamp >= ago({TimeRange:timespan})\n| summarize ExceptionCount = count() by type, bin(timestamp, 5m)\n| order by timestamp desc",
        "size": 0,
        "title": "Exceptions Over Time",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "visualization": "timechart"
      },
      "name": "query - exceptions"
    }
  ],
  "fallbackResourceIds": [],
  "fromTemplateId": "sentinel-UserWorkbook",
