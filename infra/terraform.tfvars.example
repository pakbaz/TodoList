# Example Terraform variables file
# Copy this file to terraform.tfvars and customize for your environment

# Application Configuration
app_name    = "todolist"
environment = "dev"
location    = "East US 2"

# Container Configuration
container_image = "your-acr.azurecr.io/todolist:latest"

# High Availability (set to true for production)
enable_high_availability = false

# Additional tags
tags = {
  Project     = "TodoList"
  Owner       = "DevOps Team"
  Environment = "Development"
}

# Database Configuration
db_admin_username                     = "psqladmin"
postgresql_sku                       = "GP_Standard_D2s_v3"
postgresql_storage_mb                = 32768
postgresql_backup_retention_days     = 7
postgresql_geo_redundant_backup_enabled = false

# Container Registry
acr_sku                 = "Premium"
enable_geo_replication = false

# Scaling Configuration
min_replicas              = 1
max_replicas             = 10
scale_concurrent_requests = 100

# Resource Limits
container_cpu_limit    = 0.5
container_memory_limit = "1Gi"
